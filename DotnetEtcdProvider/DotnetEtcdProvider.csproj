<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>

    <PackageId>DotnetEtcdProvider</PackageId>
    <Version>2.0.0</Version>
    <Authors>Fagan Ooi</Authors>
    <Description>It is custom configuration provider that use `dotnet-etcd` library to load the configuration and update it from time to time.</Description>
    <PackageProjectUrl>https://github.com/FaganOoi/csharp-dotnet-etcd-provider</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FaganOoi/csharp-dotnet-etcd-provider</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking changes in 2.0.0:
- Target frameworks are now net8.0 and net10.0 (was netstandard2.1); consumers must run on .NET 8+.
- Dependencies refreshed to the .NET 10 LTS line: System.Text.Json 10.0.13 (fixes CVE-2024-30105 / Dependabot alert #2), Microsoft.Extensions.Configuration* 10.0.13, and dotnet-etcd 9.1.0.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Root README includes 2.0.0 breaking-change notes shown on nuget.org -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotnet-etcd" Version="9.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

</Project>
